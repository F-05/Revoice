# Copy to .env and edit. Every value below is the built-in default.

# --- app ---
APP_NAME=speech-repair-backend
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated origins. "*" is right for Expo dev: the phone reaches the
# server on a LAN IP that changes from network to network.
CORS_ALLOW_ORIGINS=*

# --- ASR ---
# faster-whisper | openai-whisper | mock
#   mock -> no model download, always returns a fixed transcript. Use it to let
#           the frontend integrate against the API before the model is ready.
ASR_BACKEND=faster-whisper

# tiny.en | base.en | small.en | medium.en | large-v3
# Larger = more accurate, slower. Start at base.en.
WHISPER_MODEL=base.en

# auto | cpu | cuda   (Apple Silicon runs on cpu -- CTranslate2 has no Metal backend)
WHISPER_DEVICE=auto

# int8 is the fastest sane default on CPU; use float16 on CUDA.
WHISPER_COMPUTE_TYPE=int8

# Force a language, or leave empty to auto-detect.
WHISPER_LANGUAGE=en

# Load the model at startup rather than on the first request.
PRELOAD_ASR_MODEL=true

# Fixed per-word probability for ASR_BACKEND=mock. Set it below
# UNCERTAIN_WORD_THRESHOLD (e.g. 0.2) to make the mock return status=uncertain.
MOCK_WORD_PROBABILITY=0.95

# --- response status ---
# Overall confidence below this -> status=retry.
RETRY_CONFIDENCE_THRESHOLD=0.35
# Any single word below this -> status=uncertain.
UNCERTAIN_WORD_THRESHOLD=0.60

# --- TTS ---
# none   -> audio_url is always null; the app speaks with the device voice.
# system -> macOS `say`, served from /audio. Falls back to none elsewhere.
TTS_BACKEND=system
# Where generated clips are written. Empty -> <system temp>/speech-repair-audio.
# AUDIO_OUTPUT_DIR=
AUDIO_KEEP_FILES=50

# --- audio ---
MAX_UPLOAD_BYTES=26214400
# TEMP_DIR=
TRANSCODE_WITH_FFMPEG=true
# Clips shorter than this are answered with status=retry instead of being sent
# to Whisper -- a mis-tap on the record button, not speech.
MIN_AUDIO_SECONDS=0.25
