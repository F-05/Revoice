# Copy to .env and set your own values:  cp .env.example .env
#
# Point this at the FastAPI backend.
#   iOS Simulator / web browser : http://localhost:8000
#   Android emulator            : http://10.0.2.2:8000
#   Physical phone              : http://<your Mac's LAN IP>:8000
#
# On a physical phone, localhost is the PHONE — it must be the LAN IP.
# Find it with:  ipconfig getifaddr en0   (try en1 if that is empty)
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# true  -> mocked responses, no backend needed (fallback for demos)
# false -> real requests to EXPO_PUBLIC_API_URL (default)
EXPO_PUBLIC_DEMO_MODE=false
