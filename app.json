{
  "expo": {
    "name": "Revoice",
    "slug": "revoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "revoice",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6F0",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF6F0",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revoice.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Revoice uses your microphone to hear what you say so it can make your words clearer.",
        "NSLocalNetworkUsageDescription": "Revoice sends your recording to the Revoice server running on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.revoice.app",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Revoice uses your microphone to hear what you say so it can make your words clearer."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
